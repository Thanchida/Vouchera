# PostgreSQL
POSTGRES_DB=vouchera
POSTGRES_USER=vouchera
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# Service ports on host
BACKEND_PORT=8080
FRONTEND_PORT=5173

# Frontend build-time API base URL.
# For nginx reverse-proxy mode use empty value so requests remain same-origin (/api/...)
VITE_API_BASE_URL=

# Backend app configuration
VOUCHERA_CORS_ALLOWED_ORIGINS=http://localhost:5173
VOUCHERA_BOOTSTRAP_ADMIN_EMAIL=admin@vouchera.com
VOUCHERA_BOOTSTRAP_ADMIN_PASSWORD=change_me
